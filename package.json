{
  "name": "beaconhop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:ui": "playwright test",
    "test:browser": "cargo build --manifest-path src-tauri/Cargo.toml && node --test scripts/test-browser-plugin.mjs scripts/test-browser-previews.mjs",
    "icons": "node scripts/icons.mjs",
    "check:version": "node scripts/check-version.mjs",
    "plugins:prepare": "node scripts/sync-plugin-sdk.mjs && node scripts/sync-plugin-icons.mjs",
    "test:plugins": "node --test plugins/sdk/test/sdk.cjs plugins/vscode/test/files.cjs",
    "test:plugin-manager": "cargo build --manifest-path src-tauri/Cargo.toml && node --test scripts/test-plugin-manager.mjs",
    "plugins:bundle": "node scripts/bundle-plugins.mjs",
    "plugins:check-release": "node scripts/bundle-plugins.mjs --require-store",
    "prebuild": "npm run plugins:bundle",
    "predev": "npm run plugins:bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-updater": "~2.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.4.1",
    "@vscode/vsce": "4.1.0",
    "fflate": "0.8.2",
    "sharp": "^0.35.5",
    "typescript": "^5.0.2",
    "vite": "^6.3.3"
  }
}
