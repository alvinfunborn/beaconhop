{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BeaconHop plugin manifest",
  "type": "object",
  "required": [
    "protocol",
    "id",
    "name",
    "version",
    "appIds"
  ],
  "properties": {
    "protocol": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "description": "Semantic version, e.g. 1.2.3"
    },
    "appIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "thumbnails", "search"
        ]
      }
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    }
  },
  "additionalProperties": true
}
